# ===== 行尾规范 (2026-11-02) =====
#
# ⚠️ 为什么要显式写这个:
#   本仓库在 Windows 上开发 (core.autocrlf=true), 如果不加规则, .sh 文件
#   可能在 checkout 时被转成 CRLF —— **Linux 上 bash 会直接挂**
#   ("/usr/bin/env: 'bash\r': No such file or directory")。
#
#   规则:
#     - 所有 .sh / .bash 一律 LF (且不转)
#     - 后端/前端源码保持 LF (Python / TS / Vue 都对行尾不敏感, 但统一更省心)
#     - Windows 专用的 .ps1 / .bat 保持 CRLF

# ---- shell 脚本: 必须 LF ----
*.sh    text eol=lf
*.bash  text eol=lf

# ---- 后端 (Python) ----
*.py    text eol=lf
*.toml  text eol=lf
*.lock  text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
alembic.ini text eol=lf

# ---- 前端 ----
*.ts    text eol=lf
*.tsx   text eol=lf
*.vue   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.html  text eol=lf

# ---- 配置 / 文档 ----
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.conf  text eol=lf
*.tpl   text eol=lf
*.service text eol=lf

# ---- Windows 专用: 保持 CRLF ----
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# ---- 二进制 ----
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.tar   binary
*.gz    binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.mp4   binary
*.exe   binary
*.dll   binary
*.so    binary
*.pyd   binary
*.pyc   binary
