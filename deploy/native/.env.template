# TestMate 裸机部署配置 (native / systemd 模式)
#
# 用法:
#   cp deploy/native/.env.template deploy/native/.env
#   $EDITOR deploy/native/.env
#   sudo ./deploy/native/tmctl.sh install
#
# ⚠️ install 第一次跑会自动生成这个文件, 并把 JWT_SECRET / MySQL 口令 /
#    admin 口令填成随机值 —— 不用手抄, 但**要自己记下来** (admin 口令).
#
# ⚠️ 本文件含明文口令, 权限必须是 600, 且**不要**提交进 git.

# ================== 路径 ==================
# REPO_ROOT / RUNTIME_DIR 由 install 自动按实际位置写, 一般不用改
REPO_ROOT=
RUNTIME_DIR=

# ================== 服务用户 ==================
# systemd 里跑服务的账号 —— 建议专用系统用户, 不要用 root
RUN_USER=testmate
RUN_GROUP=testmate

# ================== 端口 ==================
FRONTEND_PORT=8080        # 对外访问端口 (nginx)
BACKEND_PORT=8000         # 后端端口 (只监听 127.0.0.1, 由 nginx 反代)
BIND_ADDR=127.0.0.1       # 后端绑定地址 —— 保持 127.0.0.1, 别改成 0.0.0.0

# ================== MySQL ==================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=testmate
MYSQL_USER=testmate
MYSQL_PASSWORD=change-me-testmate
# 留空 = 用 socket 免密连 root (Linux 常见); 填了就用它
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=

# ================== Redis ==================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ================== Backend ==================
JWT_SECRET=please-generate-with-openssl-rand-base64-32
JWT_EXPIRE_MINUTES=10080
AUTH_EMAIL_DOMAIN=@twsc.com.cn
TIMEZONE=Asia/Shanghai

# ⚠️ **只能 1** —— 后端的后台任务(资产市场 job 消费者 / 反向同步)走进程内队列,
#    多 worker 会重复消费同一个 job, 撞 git 的 index.lock
BACKEND_WORKERS=1
BACKEND_MEM_LIMIT=2G
BACKEND_CPU_QUOTA=200%

# ================== Admin ==================
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=change-me-before-deploy

# ================== 资产市场 ==================
# git 工作区 (裸机模式在本地磁盘, 不是容器里的 /workspace)
MARKET_DIR=
# ⚠️ 这只是**首次落库的初值** —— 实际生效的是设置页里改的值 (DB 优先).
#    host.docker.internal 是**容器里**访问宿主用的名字; 本地部署的进程跑在宿主上,
#    要能连上就得让它在宿主上指回 127.0.0.1:  tmctl.sh local hosts fix
MARKET_GIT_REMOTE=ssh://git@host.docker.internal:8922/root/testmate-market.git
MARKET_GIT_BRANCH=main
MARKET_SYNC_INTERVAL_SECONDS=30
# 资产市场 push 用的 SSH 私钥 —— 留空则 install 自动找 ~/.ssh/id_ed25519 并拷进 runtime
MARKET_SSH_KEY=
MARKET_SSH_KNOWN_HOSTS=

# ================== 外部服务 (可留空) ==================
RAGFLOW_BASE_URL=
RAGFLOW_API_KEY=
REVIEW_AGENT_BASE_URL=
REVIEW_AGENT_API_TOKEN=
DINGTALK_DEFAULT_WEBHOOK=
