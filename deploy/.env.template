# TestMate Linux 部署环境模板
# 用法:
#   cp deploy/.env.template deploy/.env
#   $EDITOR deploy/.env            # 至少改 JWT_SECRET / MYSQL_ROOT_PASSWORD / ADMIN_DEFAULT_PASSWORD
#
# 注意:容器间用 service name 通信(host=mysql / host=redis)
#      从浏览器/客户端访问才用 localhost 或 服务器 IP。

# ============== 部署基础 ==============
PROJECT_ROOT=/opt/testmate
DATA_ROOT=/opt/testmate/data

# ============== MySQL ==============
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=testmate
MYSQL_USER=testmate
MYSQL_PASSWORD=change-me-testmate
MYSQL_HOST_PORT=43060

# ============== Redis ==============
REDIS_HOST_PORT=63790

# ============== Backend ==============
JWT_SECRET=please-generate-with-openssl-rand-base64-32
JWT_EXPIRE_MINUTES=10080

# ============== Frontend ==============
FRONTEND_HOST_PORT=8080
BACKEND_HOST_PORT=18000
BACKEND_INTERNAL_URL=http://backend:8000

# ============== 钉钉 ==============
DINGTALK_DEFAULT_WEBHOOK=

# ============== Admin ==============
# ⚠️ 这里是**占位符**, 不是可用的口令 —— deploy.sh 会检查占位符并要你确认.
#    部署前必须换成自己的强口令 (>= 12 字符):
#      openssl rand -base64 18
#    ⚠️ 别用 "Admin@123" 这种 —— 它公开在 git 里, 而且正好卡在旧版 9 字符的
#    弱密码门槛上, 谁拿到仓库就能登进你的平台.
ADMIN_DEFAULT_PASSWORD=change-me-before-deploy

# ===== ReviewAgent (代码检视 V2 telemetry, 本地 SQLite) =====
REVIEW_AGENT_BASE_URL=http://host.docker.internal:3000
REVIEW_AGENT_API_TOKEN=

# ===== 资产市场 (GitLab SSH 同步) =====
# ⚠️ Linux 生产默认取 /root/.ssh 下的密钥; mac 本地模式务必改成自己的路径,
#    否则 docker 会静默建空目录挂载 —— SSH 身份失效还不报错.
GITLAB_SSH_KEY=/root/.ssh/id_ed25519
GITLAB_KNOWN_HOSTS=/root/.ssh/known_hosts
# 宿主 Qoder 安装目录 (服务端通道安装写这里)
HOST_QODER_HOME=/root/.qoder-cn
# 市场资产仓库 (GitLab SSH) —— GitLab SSH 端口是 8922 (不是 22), URL 必须带端口.
# ⚠️ 漏了这一段, 市场后台同步会直接不工作 —— 资产只落本地工作区, 推不到 GitLab.
MARKET_GIT_REMOTE=ssh://git@host.docker.internal:8922/root/testmate-market.git
MARKET_GIT_BRANCH=main
# 从 GitLab 拉取对齐的周期 (秒)
MARKET_SYNC_INTERVAL_SECONDS=30

# ===== 软件库 (软件包存放) =====
# 容器里的路径是固定的 —— compose 里写死 /data/software, 并把宿主
#   ${DATA_ROOT}/software 绑定挂载到那里, 所以这里**不用配**。
# ⚠️ 软件包最大 5G/个, 不在 tmctl.sh backup / backup.sh 的备份范围内 ——
#    要单独备份 ${DATA_ROOT}/software (见 deploy/README.md §4)。
#
# ============== 资源限制(按机器调) ==============
BACKEND_CPU_LIMIT=2.0
BACKEND_MEM_LIMIT=2g
FRONTEND_CPU_LIMIT=0.5
FRONTEND_MEM_LIMIT=256m
MYSQL_CPU_LIMIT=2.0
MYSQL_MEM_LIMIT=2g
REDIS_CPU_LIMIT=0.5
REDIS_MEM_LIMIT=512m
