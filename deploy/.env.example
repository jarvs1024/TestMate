# 复制为 .env 并填实际值

# MySQL
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=testmate
MYSQL_USER=testmate
MYSQL_PASSWORD=testmate

# JWT
JWT_SECRET=please-change-me-32-bytes-random-please-rotate
# 外部系统 (PingCode/PLM) 凭据落库主密钥 —— 标准 base64 的 32 字节:
#   openssl rand -base64 32
# ⚠️ 换掉它会让已保存的凭据不可解, 用户必须重新录入.
INTEGRATION_CREDENTIAL_KEY=please-generate-with-openssl-rand-base64-32

# 日志 (DEBUG/INFO/WARNING/ERROR) / SQL echo
LOG_LEVEL=INFO
DB_ECHO=false

# Dify (P1 接入)
DIFY_BASE_URL=http://dify:80/v1
DIFY_API_KEY=app-xxxxx

# RAGFlow (P1 接入)
RAGFLOW_BASE_URL=http://ragflow:9380/api/v1
RAGFLOW_API_KEY=ragflow-xxxxx
