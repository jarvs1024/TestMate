# 复制为 .env 并填实际值
APP_NAME=TestMate Gateway
APP_VERSION=0.1.0
DEBUG=false
# 日志级别 DEBUG/INFO/WARNING/ERROR; 留空 = DEBUG 为 true 时 DEBUG, 否则 INFO
LOG_LEVEL=
# 是否打印每条 SQL (默认 false; 排查慢查询/执行计划时才开)
DB_ECHO=false
HOST=0.0.0.0
PORT=8000

JWT_SECRET=please-change-me-32-bytes-random
JWT_EXPIRE_MINUTES=10080

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=testmate
MYSQL_PASSWORD=testmate
MYSQL_DATABASE=testmate

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

RAGFLOW_BASE_URL=http://ragflow:9380/api/v1
RAGFLOW_API_KEY=ragflow-xxxxx

DINGTALK_DEFAULT_WEBHOOK=
